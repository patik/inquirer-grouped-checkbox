{
    "name": "inquirer-grouped-checkbox",
    "version": "2.0.0",
    "description": "A searchable, grouped checkbox prompt for Inquirer.js",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "demo": "tsx demo/index.ts",
        "test": "vitest",
        "test:once": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.check.json",
        "lint": "pnpm run typecheck && eslint . --fix && pnpm run format",
        "format": "prettier . --list-different --write",
        "check-format": "prettier . --list-different",
        "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
        "ci": "pnpm build && pnpm typecheck && pnpm check-exports && pnpm test:once",
        "prepublishOnly": "pnpm build",
        "tag-release": "./scripts/tag-release.sh"
    },
    "keywords": [
        "inquirer",
        "checkbox",
        "grouped",
        "prompt",
        "cli",
        "select",
        "list",
        "categorized"
    ],
    "author": "Craig Patik",
    "repository": {
        "type": "git",
        "url": "https://github.com/patik/inquirer-grouped-checkbox.git"
    },
    "license": "MIT",
    "engines": {
        "node": ">=23.5.0 || ^22.13.0"
    },
    "packageManager": "pnpm@10.27.0",
    "dependencies": {
        "@inquirer/core": "^12.0.0",
        "@inquirer/figures": "^2.0.8"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@inquirer/testing": "^3.3.10",
        "@inquirer/type": "^4.0.7",
        "@types/node": "^26.2.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "prettier": "^3.9.6",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.12",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    }
}
